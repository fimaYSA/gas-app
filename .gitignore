# Настройки среды разработки WebStorm (IDE)
**/.idea/
*.iml
*.iws
.DS_Store

# Системная супер-защита: игнорируем тяжелые папки node_modules везде
**/node_modules/

# Локальная база данных SQLite сервера (чтобы не затереть рабочую базу на Render)
gas-backend/*.sqlite
gas-backend/*.db

# Системные файлы сборщика Expo и мобильного приложения
gas-mobile-app/.expo/
gas-mobile-app/web-build/
gas-mobile-app/dist/

# Логи ошибок npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Секретные ключи и переменные окружения
.env
.env.local
